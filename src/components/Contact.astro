---
import { site } from '../data/site.js';
---
<div data-contact>
  <div data-contact-form-wrap>
    <p style="margin: 0 0 14px 0">What's broken? A few sentences is plenty. I'll tell you honestly whether I can help. <span class="dim">Booking: {site.booking}</span></p>
    <div data-scope-box hidden style="border: 1px dashed var(--amber); padding: 10px 12px; margin-bottom: 12px; font-size: 13px">
      <div class="dim" style="font-size: 12px">ATTACHED TO YOUR MESSAGE</div>
      <div data-scope-text style="white-space: pre-line"></div>
      <button type="button" class="lnk" data-scope-clear style="margin-top: 4px; font-size: 12px">remove</button>
    </div>
    <form data-contact-form action="/api/contact" method="post" style="display: flex; flex-direction: column; gap: 12px">
      <div style="display: flex; flex-direction: column; gap: 4px"><label for="cname">Name</label><input id="cname" name="name" class="field" type="text" autocomplete="name" required maxlength="100"></div>
      <div style="display: flex; flex-direction: column; gap: 4px"><label for="cemail">Email</label><input id="cemail" name="email" class="field" type="email" autocomplete="email" required maxlength="200"></div>
      <div style="display: flex; flex-direction: column; gap: 4px"><label for="cbiz">Business / website</label><input id="cbiz" name="business" class="field" type="text" autocomplete="organization" maxlength="200"></div>
      <div style="display: flex; flex-direction: column; gap: 4px"><label for="cmsg">What's slowing you down?</label><textarea id="cmsg" name="message" class="field" rows="4" required maxlength="5000"></textarea></div>
      <div class="sr-only" aria-hidden="true"><label for="cweb">Leave this empty</label><input id="cweb" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <input type="hidden" name="scope" data-scope-input>
      <button class="btn" type="submit" data-contact-submit>SEND &gt;</button>
      <p data-contact-error role="alert" hidden style="margin: 0; color: var(--light)"></p>
    </form>
  </div>
  <div data-contact-sent hidden>
    <div class="vt" style="font-size: 28px; line-height: 1.3">&gt; MESSAGE SENT.<br>&gt; I'll reply within {site.replyTime}.<span class="blink">_</span></div>
  </div>
  <p class="dim" style="margin: 16px 0 0 0">Or email <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.linkedin}>LinkedIn</a> · <a href={site.twitch}>Twitch</a></p>
</div>
